    function parseCSV(csvText) {
      const rows = [];
      let row = [];
      let field = "";
      let inQuotes = false;

      for (let i = 0; i < csvText.length; i++) {
        const char = csvText[i];
        const next = csvText[i + 1];

        if (char === '"') {
          if (inQuotes && next === '"') {
            field += '"';
            i++;
          } else {
            inQuotes = !inQuotes;
          }
        } else if (char === "," && !inQuotes) {
          row.push(field.trim());
          field = "";
        } else if ((char === "\n" || char === "\r") && !inQuotes) {
          if (char === "\r" && next === "\n") i++;
          row.push(field.trim());
          if (row.some(cell => cell !== "")) rows.push(row);
          row = [];
          field = "";
        } else {
          field += char;
        }
      }

      if (field.length > 0 || row.length > 0) {
        row.push(field.trim());
        if (row.some(cell => cell !== "")) rows.push(row);
      }

      if (rows.length < 2) return [];
      const headers = rows[0].map(h => h.replace(/^\uFEFF/, "").trim().toLowerCase());

      return rows.slice(1).map(cells => {
        const item = {};
        headers.forEach((h, idx) => {
          item[h] = (cells[idx] || "").trim();
        });
        return item;
      });
    }

    function parseColorsCell(rawColors) {
      if (!rawColors) {
        return [{ name: "Paruthi Blush Peach", hex: "#F6B8A6" }];
      }
      return rawColors
        .split(";")
        .map(part => part.trim())
        .filter(Boolean)
        .map(entry => {
          const [namePart, hexPart] = entry.split(":");
          const name = (namePart || "Cotton Shade").trim();
          const hex = (hexPart || "#9E0B4A").trim();
          return { name, hex: hex.startsWith("#") ? hex : `#${hex}` };
        });
    }

