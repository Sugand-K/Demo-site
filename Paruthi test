              <circle cx="32" cy="22" r="9.5" fill="#FFFDF7" stroke="#D4A024" stroke-width="2" />
              <circle cx="22" cy="29" r="8.5" fill="#FFFDF7" stroke="#D4A024" stroke-width="2" />
