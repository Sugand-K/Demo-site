            class="relative inline-flex items-center gap-2 bg-berry hover:bg-berryDark text-cream px-4 py-2.5 rounded-full text-sm font-medium transition-colors shadow-sm border border-gold/30"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
