      if (!val) return false;
      if (["sold out", "out of stock", "soldout", "no", "false", "unavailable", "0"].includes(val)) {
        return true;
      }
      const num = Number(val);
      return !Number.isNaN(num) && num <= 0;
    }

    async function loadProductsFromGoogleSheet(csvUrl) {
      const noteEl = document.getElementById("inventory-source-note");
      try {
        const cacheBuster = csvUrl.includes("?") ? `&_t=${Date.now()}` : `?_t=${Date.now()}`;
        const response = await fetch(`${csvUrl}${cacheBuster}`, { cache: "no-store" });
        if (!response.ok) throw new Error("Network response not OK");

        const csvText = await response.text();
        const records = parseCSV(csvText);
        if (!records.length) throw new Error("Empty sheet");

        const mapped = records
          .filter(r => r.name)
          .map((r, idx) => {
            const price = Number(String(r.price || "0").replace(/[^0-9.]/g, "")) || 0;
            const origRaw = Number(String(r.originalprice || "0").replace(/[^0-9.]/g, "")) || 0;
            const sizes = (r.sizes || "1-2Y|2-3Y|4-5Y|6-7Y")
              .split(/[|,]/)
              .map(s => s.trim())
              .filter(Boolean);

            return {
              id: r.id || `sheet-item-${idx + 1}`,
              name: r.name,
              category: r.category || "Simple Edition (Everyday)",
              price,
              originalPrice: origRaw > price ? origRaw : null,
              stockStatus: isSoldOutStatus(r.stock) ? "Sold Out" : "In Stock",
              fabric: r.fabric || "100% Pure Cotton",
              sizes: sizes.length ? sizes : ["2-3Y"],
              colors: parseColorsCell(r.colors),
              image: r.image || "https://images.unsplash.com/photo-1518831959646-742c3a14ebf7?auto=format&fit=crop&w=800&q=80",
              description: r.description || "Soft breathable Paruthi cotton outfit crafted for kids.",
              sizeGuide: "Relaxed kids fit with soft seams."
            };
          });

        if (mapped.length > 0) {
          activeProducts = mapped;
          const sheetCats = Array.from(new Set(mapped.map(p => p.category).filter(Boolean)));
          STORE_CONFIG.categories = ["All", ...sheetCats];
          initDefaultVariants();
          renderCategoryPills();
          renderProducts();
          if (noteEl) {
            noteEl.textContent = "Live stock & prices synced from Google Sheets.";
          }
        }
      } catch (err) {
        console.warn("Google Sheet sync fallback active:", err);
        if (noteEl) {
          noteEl.textContent = "Pick your child's age size directly on any outfit and add to your bag.";
        }
      }
    }

    function triggerCottonBurst(originX, originY, count = 16) {
      for (let i = 0; i < count; i++) {
        const particle = document.createElement("div");
        particle.className = "cotton-burst-particle";

        const isPetal = i % 4 === 0;
        const isSparkle = i % 5 === 0 && !isPetal;
        const size = isSparkle ? 8 + Math.random() * 6 : 18 + Math.random() * 16;

        if (isPetal) {
          particle.innerHTML = `<svg width="${size}" height="${size}" viewBox="0 0 24 24" fill="none"><path d="M12 2C12 2 4 10 4 16C4 20 8 22 12 22C16 22 20 20 20 16C20 10 12 2 12 2Z" fill="#9E0B4A"/></svg>`;
        } else if (isSparkle) {
          particle.innerHTML = `<svg width="${size}" height="${size}" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="8" fill="#D4A024"/></svg>`;
        } else {
          particle.innerHTML = `<svg width="${size}" height="${size}" viewBox="0 0 36 36" fill="none"><circle cx="18" cy="13" r="7.5" fill="#FFFDF7" stroke="#D4A024" stroke-width="1.5"/><circle cx="12" cy="19" r="6.8" fill="#FFFDF7" stroke="#D4A024" stroke-width="1.5"/><circle cx="24" cy="19" r="6.8" fill="#FFFDF7" stroke="#D4A024" stroke-width="1.5"/><path d="M18 28C18 28 11 24 10 19C14 20 17 24 18 28Z" fill="#9E0B4A"/><path d="M18 28C18 28 25 24 26 19C22 20 19 24 18 28Z" fill="#9E0B4A"/></svg>`;
        }

        particle.style.left = `${originX - size / 2}px`;
        particle.style.top = `${originY - size / 2}px`;
        document.body.appendChild(particle);

        const angle = (Math.PI * 2 * i) / count + (Math.random() - 0.5) * 0.45;
        const velocity = 65 + Math.random() * 125;
        const tx = Math.cos(angle) * velocity;
        const ty = Math.sin(angle) * velocity - 45;
        const rot = (Math.random() - 0.5) * 320;
        const duration = 950 + Math.random() * 650;

        particle.animate(
          [
            { transform: "translate(0px, 0px) scale(0.3) rotate(0deg)", opacity: 1 },
            { transform: `translate(${tx * 0.75}px, ${ty * 0.75}px) scale(1.1) rotate(${rot * 0.6}deg)`, opacity: 1, offset: 0.45 },
            { transform: `translate(${tx}px, ${ty + 35}px) scale(0.85) rotate(${rot}deg)`, opacity: 0 }
          ],
          {
            duration,
            easing: "cubic-bezier(0.16, 1, 0.3, 1)",
            fill: "forwards"
          }
        ).onfinish = () => particle.remove();
      }
    }

    function triggerCottonBurstAtElement(el, count = 16) {
      if (!el) return;
      const rect = el.getBoundingClientRect();
      triggerCottonBurst(rect.left + rect.width / 2, rect.top + rect.height / 2, count);

      const bloom = document.getElementById("hero-cotton-bloom");
      if (bloom && el.id === "hero-logo-medallion") {
        bloom.classList.remove("animate-cotton-bloom");
        void bloom.offsetWidth;
        bloom.classList.add("animate-cotton-bloom");
      }
    }

