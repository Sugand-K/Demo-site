  <!-- 4. CATALOG FILTER BAR & KIDS PRODUCT GRID -->
  <main id="catalog-section" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-10">
      <div>
        <span class="text-xs font-bold uppercase tracking-widest text-berry">Handpicked for 0–10 Years</span>
        <h2 class="font-serif text-3xl sm:text-4xl font-semibold text-charcoal mt-1">Little Wardrobe</h2>
        <p id="inventory-source-note" class="text-sm text-muted mt-1.5">Pick your child's age size directly on any outfit and add to your bag.</p>
      </div>

      <div id="category-pills" class="flex items-center gap-2 overflow-x-auto no-scrollbar pb-1"></div>
    </div>

    <div class="flex items-center justify-between text-xs text-muted mb-6 pb-3 border-b border-gold/30">
      <span id="product-count-label">Showing all kids outfits</span>
      <button onclick="openSizeGuideModal()" class="text-berry font-semibold hover:underline sm:hidden">
        Need help with age sizes? View Chart
