<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>PARUTHI — Simple Edition, Tiny Tradition</title>

  <!-- Google Fonts: Cinzel / Playfair Display (Ornate Serif), Great Vibes (Calligraphic P), & Plus Jakarta Sans -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700&family=Great+Vibes&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />

  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>

  <!-- QRCode.js CDN for Live Dynamic UPI QR Generation -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>

  <!-- Tailwind Custom Design Tokens matching PARUTHI Logo Flavor -->
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            ivory: '#FFF7F3',        /* Soft Cotton Blush Cream */
            peach: '#FCD5C7',        /* Logo Medallion Blush Peach */
            sand: '#FCE8E0',         /* Warm Peach Tint */
            cream: '#FFFDF7',        /* Pure Cotton Puff Cream */
            charcoal: '#241B1E',     /* Deep Plum-Charcoal Text */
            muted: '#6D585E',        /* Soft Rose-Taupe Muted Text */
            berry: '#9E0B4A',        /* Logo Deep Berry Magenta */
            berryDark: '#7C0839',    /* Hover Berry Magenta */
            gold: '#D4A024',         /* Logo Antique Gold */
            goldLight: '#F2CE68',    /* Gold Shimmer Highlight */
            olive: '#5D6E4E',        /* Natural Calyx Leaf Green */
          },
          fontFamily: {
            serif: ['"Playfair Display"', 'Georgia', 'serif'],
            display: ['"Cinzel"', 'Georgia', 'serif'],
            script: ['"Great Vibes"', 'cursive'],
            sans: ['"Plus Jakarta Sans"', 'system-ui', 'sans-serif'],
          },
        },
      },
    };
  </script>

  <style>
    body {
      background-color: #FFF7F3;
      color: #241B1E;
      font-family: 'Plus Jakarta Sans', sans-serif;
      overflow-x: hidden;
    }
    .no-scrollbar::-webkit-scrollbar {
      display: none;
    }
    .no-scrollbar {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }

    @keyframes slideUpFade {
      0% { opacity: 0; transform: translate(-50%, 16px); }
      100% { opacity: 1; transform: translate(-50%, 0); }
    }
    .toast-enter {
      animation: slideUpFade 0.25s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .gold-ring {
      box-shadow: 0 0 0 3px #D4A024, 0 0 0 6px #F2CE68, 0 18px 40px -10px rgba(158, 11, 74, 0.22);
    }

    @keyframes cottonBloom {
      0% { transform: scale(0.75) rotate(-6deg); opacity: 0.4; }
      55% { transform: scale(1.12) rotate(3deg); opacity: 1; }
      80% { transform: scale(0.97) rotate(-1deg); }
      100% { transform: scale(1) rotate(0deg); opacity: 1; }
    }
    .animate-cotton-bloom {
      animation: cottonBloom 1.1s cubic-bezier(0.22, 1, 0.36, 1) forwards;
      transform-origin: center bottom;
    }

    @keyframes floatSlow {
      0%, 100% { transform: translateY(0px) rotate(0deg); }
      50% { transform: translateY(-14px) rotate(8deg); }
    }
    .animate-float-slow {
      animation: floatSlow 5.5s ease-in-out infinite;
    }
    .animate-float-delayed {
      animation: floatSlow 7s ease-in-out 1.8s infinite;
    }

    .cotton-burst-particle {
      position: fixed;
      pointer-events: none;
      z-index: 9999;
      will-change: transform, opacity;
    }
  </style>
</head>
<body class="antialiased selection:bg-berry selection:text-white">

  <!-- 1. TOP ANNOUNCEMENT BAR -->
  <div id="announcement-bar" class="bg-berry text-cream text-xs sm:text-sm py-2.5 px-4 text-center tracking-wide font-medium border-b border-gold/40"></div>

  <!-- 2. STICKY HEADER -->
