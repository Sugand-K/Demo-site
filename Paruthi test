    function addToCart(productId, triggerEl) {
      const product = activeProducts.find(p => p.id === productId);
      if (!product || product.stockStatus === "Sold Out") return;

      if (triggerEl) {
        triggerCottonBurstAtElement(triggerEl, 14);
      }

      const variant = selectedVariants[productId];
      const cartKey = `${product.id}_${variant.size}_${variant.color}`;

      const existingItem = cart.find(item => item.key === cartKey);
      if (existingItem) {
        existingItem.qty += 1;
      } else {
        cart.push({
          key: cartKey,
          id: product.id,
          name: product.name,
          price: product.price,
          image: product.image,
          size: variant.size,
          color: variant.color,
          qty: 1
        });
      }

      saveCart();
      updateCartUI();
      showToast(`Added ${product.name} (${variant.size}) to bag`);
      setTimeout(() => toggleCartDrawer(true), 260);
    }

    function updateItemQty(cartKey, delta) {
      const idx = cart.findIndex(item => item.key === cartKey);
      if (idx === -1) return;

      cart[idx].qty += delta;
      if (cart[idx].qty <= 0) {
        cart.splice(idx, 1);
      }

      saveCart();
      updateCartUI();
    }

    function removeCartItem(cartKey) {
      cart = cart.filter(item => item.key !== cartKey);
      saveCart();
      updateCartUI();
    }

    function calculateTotals() {
      const subtotal = cart.reduce((sum, item) => sum + item.price * item.qty, 0);
      const totalItems = cart.reduce((sum, item) => sum + item.qty, 0);
      const qualifiesFreeShipping = subtotal >= STORE_CONFIG.freeShippingThreshold || subtotal === 0;
      const shipping = qualifiesFreeShipping ? 0 : STORE_CONFIG.flatShippingCharge;
      const grandTotal = subtotal + shipping;

      return { subtotal, totalItems, qualifiesFreeShipping, shipping, grandTotal };
    }

    function updateCartUI() {
      const { subtotal, totalItems, shipping, grandTotal } = calculateTotals();

      document.getElementById("cart-badge").textContent = totalItems;
      document.getElementById("drawer-item-count").textContent = `${totalItems} ${totalItems === 1 ? "outfit" : "outfits"} selected`;

      const progressText = document.getElementById("shipping-progress-text");
      const progressBar = document.getElementById("shipping-progress-bar");

      if (subtotal === 0) {
        progressText.textContent = `Add ${STORE_CONFIG.currencySymbol}${STORE_CONFIG.freeShippingThreshold} for FREE Shipping across India!`;
        progressBar.style.width = "0%";
      } else if (subtotal >= STORE_CONFIG.freeShippingThreshold) {
        progressText.innerHTML = `✨ You've unlocked <strong class="text-berry">FREE Shipping</strong> across India!`;
        progressBar.style.width = "100%";
      } else {
        const remaining = STORE_CONFIG.freeShippingThreshold - subtotal;
        const pct = Math.min(100, Math.round((subtotal / STORE_CONFIG.freeShippingThreshold) * 100));
        progressText.innerHTML = `Add <strong>${STORE_CONFIG.currencySymbol}${remaining}</strong> more for FREE Shipping!`;
        progressBar.style.width = `${pct}%`;
      }

      const emptyView = document.getElementById("empty-cart-view");
      const itemsContainer = document.getElementById("cart-items-container");
      const checkoutSection = document.getElementById("checkout-section");

      if (cart.length === 0) {
        emptyView.classList.remove("hidden");
        itemsContainer.innerHTML = "";
        checkoutSection.classList.add("hidden");
        return;
      }

      emptyView.classList.add("hidden");
      checkoutSection.classList.remove("hidden");

      itemsContainer.innerHTML = cart.map(item => `
        <div class="flex gap-3.5 bg-white p-3 rounded-2xl border border-gold/40">
          <img
            src="${item.image}"
            onerror="this.src='https://placehold.co/200x250/FCD5C7/9E0B4A?text=Kids+Item'"
            alt="${item.name}"
            class="w-16 h-20 rounded-xl object-cover bg-sand shrink-0"
          />
          <div class="flex-1 min-w-0 flex flex-col justify-between">
            <div>
              <div class="flex items-start justify-between gap-2">
                <h4 class="text-sm font-semibold text-charcoal truncate">${item.name}</h4>
                <button
                  onclick="removeCartItem('${item.key}')"
                  aria-label="Remove item"
                  class="text-xs text-muted hover:text-berry px-1"
                >
                  ✕
                </button>
              </div>
              <p class="text-xs text-muted mt-0.5">Age Size: <strong class="text-berry">${item.size}</strong> • ${item.color}</p>
            </div>

            <div class="flex items-center justify-between mt-2">
              <div class="inline-flex items-center border border-gold/40 rounded-lg bg-sand/50">
                <button onclick="updateItemQty('${item.key}', -1)" class="px-2.5 py-0.5 text-sm font-bold text-berry hover:text-berryDark">−</button>
                <span class="px-2 text-xs font-bold text-charcoal">${item.qty}</span>
                <button onclick="updateItemQty('${item.key}', 1)" class="px-2.5 py-0.5 text-sm font-bold text-berry hover:text-berryDark">+</button>
              </div>
              <span class="text-sm font-bold text-charcoal">${STORE_CONFIG.currencySymbol}${(item.price * item.qty).toLocaleString("en-IN")}</span>
            </div>
          </div>
        </div>
      `).join("");

      document.getElementById("summary-subtotal").textContent = `${STORE_CONFIG.currencySymbol}${subtotal.toLocaleString("en-IN")}`;
      document.getElementById("summary-shipping").textContent = shipping === 0 ? "FREE" : `${STORE_CONFIG.currencySymbol}${shipping}`;
      document.getElementById("summary-total").textContent = `${STORE_CONFIG.currencySymbol}${grandTotal.toLocaleString("en-IN")}`;

      updateDynamicUpiPayment(grandTotal);
    }

    function setPaymentMode(mode) {
      paymentMode = mode;
      const upiBtn = document.getElementById("pay-mode-upi");
      const codBtn = document.getElementById("pay-mode-cod");
      const upiBox = document.getElementById("upi-payment-box");

      if (mode === "UPI") {
        upiBtn.className = "p-3 rounded-xl border-2 border-berry bg-peach/45 text-left transition-all";
        codBtn.className = "p-3 rounded-xl border border-gold/40 bg-white text-left transition-all";
        upiBox.classList.remove("hidden");
        const { grandTotal } = calculateTotals();
        updateDynamicUpiPayment(grandTotal);
      } else {
        codBtn.className = "p-3 rounded-xl border-2 border-berry bg-peach/45 text-left transition-all";
        upiBtn.className = "p-3 rounded-xl border border-gold/40 bg-white text-left transition-all";
        upiBox.classList.add("hidden");
      }
    }

    function updateDynamicUpiPayment(amount) {
      if (amount <= 0) return;

      document.getElementById("upi-amount-pill").textContent = `${STORE_CONFIG.currencySymbol}${amount.toLocaleString("en-IN")}`;

      const encodedName = encodeURIComponent(STORE_CONFIG.brandName);
      const upiNote = encodeURIComponent(`Paruthi Kids Order`);
      const upiUrl = `upi://pay?pa=${STORE_CONFIG.upiId}&pn=${encodedName}&am=${amount.toFixed(2)}&cu=INR&tn=${upiNote}`;

      document.getElementById("upi-deep-link").href = upiUrl;

      const qrContainer = document.getElementById("upi-qrcode-canvas");
      qrContainer.innerHTML = "";
      if (typeof QRCode !== "undefined") {
        qrCodeInstance = new QRCode(qrContainer, {
          text: upiUrl,
          width: 156,
          height: 156,
          colorDark: "#241B1E",
          colorLight: "#FFFFFF",
          correctLevel: QRCode.CorrectLevel.M
        });
      }
    }

    function submitOrderViaWhatsApp() {
      if (cart.length === 0) {
        showToast("Your Paruthi bag is empty.");
        return;
      }

      const name = document.getElementById("cust-name").value.trim();
      const phone = document.getElementById("cust-phone").value.trim();
      const address = document.getElementById("cust-address").value.trim();
      const pincode = document.getElementById("cust-pincode").value.trim();

      if (!name || !phone || !address || !pincode) {
        showToast("Please fill in Parent Name, Phone, Address & Pincode.");
        return;
      }

      const { subtotal, shipping, grandTotal } = calculateTotals();
      const orderId = "PRT-" + Math.floor(100000 + Math.random() * 900000);

      const itemsLines = cart
        .map(
          (item, index) =>
            `${index + 1}. *${item.name}*\n   Age Size: ${item.size} | Shade: ${item.color} | Qty: ${item.qty} — ${STORE_CONFIG.currencySymbol}${(
              item.price * item.qty
            ).toLocaleString("en-IN")}`
        )
        .join("\n");

      const paymentLabel =
        paymentMode === "UPI"
          ? `UPI Instant Pay (UPI ID: ${STORE_CONFIG.upiId})`
          : "Cash on Delivery / WhatsApp Confirmation";

      const message =
        `🌸 *NEW ORDER — ${STORE_CONFIG.brandName}* (${STORE_CONFIG.tagline})\n` +
        `Order Ref: *${orderId}*\n` +
        `--------------------------------\n` +
        `*KIDS ITEMS ORDERED:*\n${itemsLines}\n` +
        `--------------------------------\n` +
        `Subtotal: ${STORE_CONFIG.currencySymbol}${subtotal.toLocaleString("en-IN")}\n` +
        `Shipping: ${shipping === 0 ? "FREE" : STORE_CONFIG.currencySymbol + shipping}\n` +
        `*GRAND TOTAL: ${STORE_CONFIG.currencySymbol}${grandTotal.toLocaleString("en-IN")}*\n` +
        `Payment Mode: *${paymentLabel}*\n` +
        `--------------------------------\n` +
        `*DELIVERY DETAILS:*\n` +
        `Parent Name: ${name}\n` +
        `Phone: ${phone}\n` +
        `Address: ${address} - ${pincode}\n\n` +
        `Please confirm availability and dispatch timeline. Thank you!`;

      const waUrl = `https://wa.me/${STORE_CONFIG.whatsappNumber}?text=${encodeURIComponent(message)}`;
      window.open(waUrl, "_blank", "noopener,noreferrer");
    }

    function showToast(text) {
      const container = document.getElementById("toast-container");
      const toast = document.createElement("div");
      toast.className =
        "toast-enter bg-berry text-cream text-xs sm:text-sm font-medium px-5 py-3 rounded-full shadow-xl border border-gold whitespace-nowrap";
      toast.textContent = text;
      container.innerHTML = "";
      container.appendChild(toast);

      setTimeout(() => {
        if (container.contains(toast)) {
          toast.remove();
        }
      }, 2800);
    }
  </script>
</body>
</html>
